# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.

# --- Database (Supabase Postgres) ---
# Runtime connection used by the app (transaction pooler, port 6543).
DATABASE_URL=
# Connection used ONLY for manual Prisma migrations (session pooler, port 5432).
# Not a normal application runtime dependency; do not add to Vercel unless the
# build configuration truly requires it.
MIGRATION_DATABASE_URL=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini

# --- Gene retrieval ---
# Minimum cosine similarity (0-1) a chunk must reach to be used as context.
GENE_MINIMUM_SIMILARITY=0.45
# Server-side public access flag for POST /api/gene/chat. Never prefixed with
# NEXT_PUBLIC_. In production the route is only served when this is exactly true.
GENE_PUBLIC_ENABLED=false

# --- Rate limiting (Upstash Redis) ---
# Required in production when GENE_PUBLIC_ENABLED=true. Optional in local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
