# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.

# --- Database (Supabase Postgres) ---
# Runtime connection used by the app (transaction pooler, port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
# Connection used for Prisma migrations (session pooler, port 5432).
MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini

# --- Gene retrieval ---
# Minimum cosine similarity (0-1) a chunk must reach to be used as context.
GENE_MINIMUM_SIMILARITY=0.45